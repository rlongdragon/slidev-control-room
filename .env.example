PORT=3000
SLIDEV_PORT=3031

# Optional publication-state file. Relative paths resolve from the project root.
STATE_FILE=data/decks.json

# Required in production. When omitted, a temporary password is printed at startup.
ADMIN_PASSWORD=

# Required in production. Changing it signs out existing sessions.
SESSION_SECRET=

# Optional: protects Slidev Presenter View. A random value is used when omitted.
REMOTE_PASSWORD=

# Set false only when serving plain HTTP without a TLS reverse proxy.
COOKIE_SECURE=true
